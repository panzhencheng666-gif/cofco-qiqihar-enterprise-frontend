# Enterprise official frontend (overview map) runtime defaults for local development.
#
# Keep all values optional. Empty values will fall back to current browser host
# and defaults (http://<host>:63200/#/overview).

# Optional: hard override the base URL used when opening pages in business platform.
VITE_BUSINESS_PLATFORM_URL=

# Optional: override only host for business platform cross-linking.
VITE_BUSINESS_PLATFORM_HOST=

# Optional: override only port for business platform cross-linking.
VITE_BUSINESS_PLATFORM_PORT=
